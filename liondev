<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>LionDevelopment</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Press+Start+2P&display=swap');

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#060202;
    color:#fff;
    font-family:Inter,Arial,sans-serif;
    min-height:100vh;
}

/* BACKGROUND */

body:before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    opacity:.08;
    background-image:
        linear-gradient(#ff2020 1px,transparent 1px),
        linear-gradient(90deg,#ff2020 1px,transparent 1px);
    background-size:50px 50px;
}

body:after{
    content:"";
    position:fixed;
    width:700px;
    height:700px;
    top:-350px;
    left:50%;
    transform:translateX(-50%);
    background:#d90000;
    filter:blur(220px);
    opacity:.1;
    pointer-events:none;
}

/* HEADER */

header{
    position:fixed;
    top:0;
    left:0;
    right:0;
    z-index:1000;

    min-height:78px;
    padding:13px 6%;

    display:flex;
    justify-content:space-between;
    align-items:center;

    background:rgba(7,2,2,.82);
    backdrop-filter:blur(20px);

    border-bottom:1px solid rgba(255,40,40,.25);
}

.logo{
    display:flex;
    align-items:center;
    gap:10px;

    font-family:"Press Start 2P";
    font-size:14px;

    text-shadow:
        0 0 12px #ff0000,
        3px 3px #450000;
}

.logo-icon{
    font-size:30px;
    filter:drop-shadow(0 0 10px #ff0000);
}

nav{
    display:flex;
    gap:4px;
    flex-wrap:wrap;
    justify-content:center;
}

nav button{
    background:transparent;
    border:0;
    color:#888;

    padding:11px 12px;

    font-size:10px;
    font-weight:900;
    letter-spacing:1px;

    cursor:pointer;
    transition:.25s;
}

nav button:hover{
    color:#fff;
    text-shadow:0 0 15px #ff2020;
}

/* PAGE */

.page{
    display:none;
    min-height:100vh;
    padding:125px 7% 70px;
}

.page.active{
    display:block;
}

/* HERO */

.hero{
    min-height:calc(100vh - 80px);

    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;

    text-align:center;
}

.badge{
    display:inline-block;

    padding:9px 17px;

    border:1px solid #ff3030;
    border-radius:100px;

    color:#ff5050;
    background:rgba(255,0,0,.06);

    font-size:10px;
    font-weight:900;
    letter-spacing:2px;

    box-shadow:0 0 25px rgba(255,0,0,.12);
}

.lion{
    font-size:105px;
    margin:30px 0 10px;

    filter:
        drop-shadow(0 0 15px #ff0000)
        drop-shadow(0 15px 0 #250000);

    animation:float 4s ease-in-out infinite;
}

@keyframes float{
    50%{
        transform:translateY(-12px);
    }
}

.hero h1{
    font-family:"Press Start 2P";
    font-size:clamp(27px,6vw,68px);

    background:linear-gradient(
        180deg,
        #fff,
        #ff6666 35%,
        #e00000 70%,
        #700000
    );

    -webkit-background-clip:text;
    color:transparent;
}

.hero p{
    max-width:650px;
    margin:25px auto;

    color:#999;
    font-size:16px;
    line-height:1.8;
}

.buttons{
    display:flex;
    gap:15px;
    flex-wrap:wrap;
    justify-content:center;
}

/* BUTTON */

.btn{
    display:inline-block;

    padding:15px 22px;

    color:#fff;
    text-decoration:none;

    border:0;

    font-weight:900;
    font-size:11px;

    cursor:pointer;

    transition:.25s;

    clip-path:polygon(
        0 0,
        calc(100% - 8px) 0,
        100% 8px,
        100% 100%,
        8px 100%,
        0 calc(100% - 8px)
    );
}

.red{
    background:#dc1515;
}

.red:hover{
    background:#ff2929;
    transform:translateY(-4px);
    box-shadow:0 10px 30px rgba(255,0,0,.3);
}

.dark{
    background:#160707;
    border:1px solid #541313;
}

.dark:hover{
    border-color:#ff3030;
    transform:translateY(-4px);
}

/* STATS */

.stats{
    width:100%;
    max-width:800px;

    display:grid;
    grid-template-columns:repeat(3,1fr);

    gap:15px;

    margin-top:65px;
}

.stat{
    padding:22px;

    background:#100404;
    border:1px solid #3d1010;
}

.stat strong{
    display:block;
    color:#ff3030;
    font-size:25px;
    margin-bottom:7px;
}

.stat span{
    color:#666;
    font-size:10px;
    font-weight:800;
}

/* SECTION */

.section-title{
    margin-bottom:42px;
}

.section-title small{
    color:#ff3030;
    font-size:10px;
    font-weight:900;
    letter-spacing:3px;
}

.section-title h2{
    margin-top:12px;

    font-family:"Press Start 2P";
    font-size:28px;

    text-shadow:4px 4px #350000;
}

/* GRID */

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(235px,1fr));
    gap:22px;
}

/* CARD */

.card{
    position:relative;

    padding:28px;

    background:
        linear-gradient(
            145deg,
            rgba(57,7,7,.95),
            rgba(13,3,3,.98)
        );

    border:1px solid #481313;

    transition:.3s;

    box-shadow:0 15px 40px rgba(0,0,0,.35);
}

.card:hover{
    transform:translateY(-7px);
    border-color:#a51c1c;
    box-shadow:0 20px 50px rgba(255,0,0,.12);
}

.icon{
    font-size:38px;
    margin-bottom:18px;
    filter:drop-shadow(0 0 8px #ff1616);
}

.card h3{
    font-size:18px;
    margin-bottom:12px;
}

.card p{
    color:#888;
    font-size:13px;
    line-height:1.7;
}

.free{
    color:#42ff73;
    font-size:12px;
    font-weight:900;
    margin:18px 0;
}

.price{
    color:#fff;
    font-size:27px;
    font-weight:900;
    margin:20px 0;
}

.price span{
    color:#777;
    font-size:11px;
}

/* DOWNLOAD */

.download-card{
    display:flex;
    flex-direction:column;
}

.download-card .btn{
    margin-top:auto;
    text-align:center;
}

/* STORE */

.store-card .btn{
    width:100%;
    text-align:center;
}

/* SOFTWARE */

.software-box{
    min-height:500px;

    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;

    text-align:center;

    border:1px solid #4a1111;

    background:
        radial-gradient(
            circle,
            rgba(190,0,0,.17),
            transparent 60%
        );
}

.software-icon{
    font-size:90px;
    margin-bottom:25px;

    animation:float 4s infinite;
}

.software-box h2{
    font-family:"Press Start 2P";
    color:#ff3333;
    font-size:26px;
}

.software-box p{
    max-width:550px;
    margin-top:20px;
    color:#777;
    line-height:1.8;
}

/* TICKETS */

.ticket-container{
    max-width:760px;
    margin:auto;
}

.ticket-info{
    text-align:center;
    margin-bottom:30px;
}

.ticket-info h3{
    font-size:22px;
    margin-bottom:12px;
}

.ticket-info p{
    color:#777;
    line-height:1.7;
}

.ticket-form{
    background:
        linear-gradient(
            145deg,
            rgba(52,7,7,.95),
            rgba(13,3,3,.98)
        );

    border:1px solid #501313;
    padding:35px;

    box-shadow:0 20px 60px rgba(0,0,0,.4);
}

.field{
    margin-bottom:20px;
}

.field label{
    display:block;
    margin-bottom:9px;

    color:#aaa;

    font-size:11px;
    font-weight:800;
    letter-spacing:1px;
}

.field input,
.field textarea{
    width:100%;

    padding:16px;

    background:#0c0303;

    border:1px solid #451010;
    outline:none;

    color:#fff;

    font-family:Inter,Arial,sans-serif;
    font-size:14px;

    transition:.25s;
}

.field textarea{
    min-height:180px;
    resize:vertical;
}

.field input:focus,
.field textarea:focus{
    border-color:#ff2929;
    box-shadow:0 0 20px rgba(255,0,0,.08);
}

.ticket-form .btn{
    width:100%;
}

/* ================= QUESTION HUB ================= */

.question-layout{
    max-width:950px;
    margin:auto;
}

.ask-box{
    background:
        linear-gradient(
            145deg,
            rgba(55,7,7,.95),
            rgba(13,3,3,.98)
        );

    border:1px solid #501313;
    padding:28px;

    margin-bottom:35px;

    box-shadow:0 20px 50px rgba(0,0,0,.35);
}

.ask-box h3{
    font-size:20px;
    margin-bottom:20px;
}

.question-input,
.answer-input{
    width:100%;

    background:#090303;
    color:#fff;

    border:1px solid #481111;
    outline:none;

    padding:15px;

    font-family:Inter,Arial,sans-serif;
    font-size:14px;

    margin-bottom:13px;
}

.question-input:focus,
.answer-input:focus{
    border-color:#ff2929;
}

textarea.question-input{
    min-height:130px;
    resize:vertical;
}

.question{
    background:#110404;

    border:1px solid #431010;

    padding:25px;

    margin-bottom:20px;

    transition:.25s;
}

.question:hover{
    border-color:#8f1b1b;
}

.question-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin-bottom:14px;
}

.question-user{
    color:#ff4141;
    font-size:12px;
    font-weight:900;
}

.question-time{
    color:#555;
    font-size:10px;
}

.question-title{
    font-size:19px;
    margin-bottom:10px;
}

.question-text{
    color:#999;
    line-height:1.7;
    font-size:14px;
}

.answers{
    margin-top:22px;
    padding-top:20px;
    border-top:1px solid #301010;
}

.answer{
    background:#190606;
    border-left:3px solid #d71b1b;

    padding:15px;
    margin-top:12px;
}

.answer-name{
    color:#ff5555;
    font-weight:800;
    font-size:12px;
    margin-bottom:7px;
}

.answer-text{
    color:#aaa;
    font-size:13px;
    line-height:1.6;
}

.answer-form{
    margin-top:20px;
}

.empty{
    text-align:center;
    padding:70px 20px;

    color:#555;

    border:1px dashed #421010;
}

/* FOOTER */

footer{
    padding:35px 7%;

    border-top:1px solid #301010;

    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:15px;

    color:#555;
    font-size:11px;
}

footer b{
    color:#ff2929;
}

/* MOBILE */

@media(max-width:750px){

    header{
        flex-direction:column;
        gap:7px;
        padding:12px 3%;
    }

    .logo{
        font-size:10px;
    }

    .logo-icon{
        font-size:23px;
    }

    nav{
        width:100%;
        overflow-x:auto;
        flex-wrap:nowrap;
    }

    nav button{
        flex-shrink:0;
        padding:8px;
        font-size:8px;
    }

    .page{
        padding:145px 5% 60px;
    }

    .lion{
        font-size:72px;
    }

    .hero p{
        font-size:14px;
    }

    .stats{
        grid-template-columns:1fr;
        margin-top:45px;
    }

    .ticket-form,
    .ask-box{
        padding:22px;
    }

    .question-header{
        align-items:flex-start;
        flex-direction:column;
    }

    footer{
        justify-content:center;
        text-align:center;
    }
}
</style>
</head>

