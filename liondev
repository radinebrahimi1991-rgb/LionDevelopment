<script>

/* ================= PAGE SYSTEM ================= */

function showPage(page){

    document
        .querySelectorAll(".page")
        .forEach(
            element =>
            element.classList.remove("active")
        );

    document
        .getElementById(page)
        .classList.add("active");

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}


/* ================= QUESTION HUB ================= */

let questions =
    JSON.parse(
        localStorage.getItem("lionQuestions") || "[]"
    );


function saveQuestions(){

    localStorage.setItem(
        "lionQuestions",
        JSON.stringify(questions)
    );

}


function addQuestion(){

    const name =
        document.getElementById("questionName").value.trim();

    const title =
        document.getElementById("questionTitle").value.trim();

    const text =
        document.getElementById("questionText").value.trim();


    if(!name || !title || !text){

        alert("Please fill in all fields.");

        return;
    }


    const question = {

        id:Date.now(),

        name:name,

        title:title,

        text:text,

        date:new Date().toLocaleString(),

        answers:[]

    };


    questions.unshift(question);

    saveQuestions();

    document.getElementById("questionName").value="";
    document.getElementById("questionTitle").value="";
    document.getElementById("questionText").value="";

    renderQuestions();

}


function addAnswer(id){

    const nameInput =
        document.getElementById("answerName-"+id);

    const answerInput =
        document.getElementById("answerText-"+id);


    const name =
        nameInput.value.trim();

    const text =
        answerInput.value.trim();


    if(!name || !text){

        alert("Please enter your name and answer.");

        return;
    }


    const question =
        questions.find(q => q.id === id);


    if(!question){
        return;
    }


    question.answers.push({

        name:name,

        text:text,

        date:new Date().toLocaleString()

    });


    saveQuestions();

    renderQuestions();

}


function renderQuestions(){

    const list =
        document.getElementById("questionList");


    if(questions.length === 0){

        list.innerHTML = `
            <div class="empty">
                No questions yet.<br><br>
                Be the first person to ask!
            </div>
        `;

        return;
    }


    list.innerHTML =
        questions.map(q => `

        <div class="question">

            <div class="question-header">

                <div class="question-user">
                    👤 ${escapeHTML(q.name)}
                </div>

                <div class="question-time">
                    ${escapeHTML(q.date)}
                </div>

            </div>


            <div class="question-title">
                ${escapeHTML(q.title)}
            </div>


            <div class="question-text">
                ${escapeHTML(q.text)}
            </div>


            <div class="answers">

                <strong>
                    💬 Answers (${q.answers.length})
                </strong>


                ${
                    q.answers.length === 0
                    ?
                    `<p style="color:#555;margin-top:12px;">
                        No answers yet. Be the first to help!
                    </p>`
                    :
                    q.answers.map(a => `

                        <div class="answer">

                            <div class="answer-name">
                                ${escapeHTML(a.name)}
                            </div>

                            <div class="answer-text">
                                ${escapeHTML(a.text)}
                            </div>

                        </div>

                    `).join("")
                }


                <div class="answer-form">

                    <input
                        id="answerName-${q.id}"
                        class="answer-input"
                        placeholder="Your name">

                    <textarea
                        id="answerText-${q.id}"
                        class="answer-input"
                        placeholder="Write your answer..."></textarea>

                    <button
                        class="btn red"
                        onclick="addAnswer(${q.id})">

                        POST ANSWER

                    </button>

                </div>

            </div>

        </div>

    `).join("");

}


function escapeHTML(value){

    return String(value)
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


renderQuestions();

</script>

</body>
</html>
